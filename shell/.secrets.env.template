# Secrets, DO NOT commit this file.
# Copy to ~/.secrets.env and fill in your values. Sourced automatically by .zshrc.
#
# IMPORTANT for AI AGENTS (Claude, etc.): the live copy at ~/.secrets.env is
# mirrored to ~/Library/Mobile Documents/com~apple~CloudDocs/.secrets.env for
# new-Mac bootstrap. Whenever you add, remove, or change a value in one, make
# the identical edit in the other. There is no sync script.
#
# Activation table (see setup.sh step 21 for the wiring):
#
#   Auto-applied at setup time (defaults write or sed into a config file):
#     SINGLEBOX_KEY        -> singlebox/Settings (sed substitution)
#     ALDENTE_EMAIL/KEY    -> com.apphousekitchen.aldente-pro
#     BARTENDER_KEY        -> com.surteesstudios.Bartender (license6)
#     NAS_SMB_PASSWORD     -> macOS Keychain (smb://warren@192.168.10.2)
#     XCODES_USERNAME/PWD  -> consumed by xcodes during Xcode install
#
#   Stored for re-entry, must be pasted into the app on first launch:
#     TGPRO_KEY            -> TG Pro > Preferences > Registration
#     BETTERDISPLAY_KEY    -> BetterDisplay > Preferences > Licence
#     SIMGENIE_KEY         -> Sim Genie > Licence
#     BOOTSPLASH_KEY       -> kept here as a record; used by react-native-bootsplash CLI when generating splash screens

# Singlebox licence (auto-applied)
export SINGLEBOX_KEY=

# BetterDisplay Pro licence (manual paste)
export BETTERDISPLAY_EMAIL=
export BETTERDISPLAY_KEY=

# Sim Genie licence (manual paste)
export SIMGENIE_KEY=

# react-native-bootsplash Pro licence (consumed by the CLI when generating splashes)
export BOOTSPLASH_KEY=

# AlDente Pro licence (auto-applied)
export ALDENTE_EMAIL=
export ALDENTE_KEY=

# Synology NAS configuration (consumed by nas/mount-nas.sh on each login).
# NAS_LAN_HOST is preferred; NAS_TAILSCALE_HOST is the fallback when off-LAN.
# At least one host must be set, plus NAS_USER. NAS_SHARES is space-separated.
# NAS_SMB_PASSWORD is auto-applied to the macOS Keychain at setup time.
export NAS_USER=
export NAS_LAN_HOST=
export NAS_TAILSCALE_HOST=
export NAS_SHARES="video home"
export NAS_SMB_PASSWORD=

# Apple ID (used by xcodes for Xcode downloads)
export XCODES_USERNAME=
export XCODES_PASSWORD=

# TG Pro licence (manual paste into TG Pro > Preferences > Registration)
export TGPRO_KEY=

# Bartender 6 licence (auto-applied; BARTENDER_HOLDER optional, defaults to git email)
export BARTENDER_KEY=
export BARTENDER_HOLDER=

# Add other secrets below as needed
