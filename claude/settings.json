{
  "cleanupPeriodDays": 999999,
  "includeCoAuthoredBy": false,
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|SendUserFile|Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Developer/dotfiles/claude/hooks/verify-receipt.sh"
          }
        ]
      },
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Developer/dotfiles/claude/hooks/consent-gate.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Finished, ready for you\" with title \"Claude Code\"'",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Developer/dotfiles/claude/hooks/reply-length-gate.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Developer/dotfiles/claude/hooks/inject-context.sh"
          },
          {
            "type": "command",
            "command": "cd $HOME/Developer/dotfiles/rag && $HOME/.rag/venv/bin/python -m src.prompt_restore",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd $HOME/Developer/dotfiles/rag && $HOME/.rag/venv/bin/python -m src.session_restore"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Developer/dotfiles/claude/hooks/session-end-summarise.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "understand-anything@understand-anything": true,
    "clangd-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "understand-anything": {
      "source": {
        "source": "github",
        "repo": "Lum1104/Understand-Anything"
      }
    }
  },
  "outputStyle": "Warren",
  "effortLevel": "high",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "voiceEnabled": true,
  "agentPushNotifEnabled": true
}
