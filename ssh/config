Include ~/.colima/ssh_config

# ===========================================================================
# SSH Config
# Symlinked to ~/.ssh/config by setup.sh
# ===========================================================================

# minipc: LAN IP when reachable (at home → instant), tailscale IP otherwise (away from home).
# Keeps remote flexibility while not depending on tailscale MagicDNS to resolve the bare
# `ubuntu-minipc` name — when tailscaled drops, that name dies and silently took out the mbp16
# transcode worker (2026-06-28). HostKeyAlias gives both paths one stable known_hosts entry.
Match host minipc exec "nc -z -G 1 192.168.10.171 22 >/dev/null 2>&1"
    HostName 192.168.10.171
Host minipc
    HostName 100.118.77.94
    User warren
    HostKeyAlias ubuntu-minipc
    ControlMaster auto
    ControlPath ~/.ssh/cm-%r@%h:%p
    ControlPersist 600
    ServerAliveInterval 15

Host minipc-tailscale
    HostName 100.118.77.94
    User warren

Host minipc-lan
    HostName 192.168.10.171
    User warren

# homeassistant: Home Assistant Green. Same LAN-first pattern as minipc above.
# Lands in the Advanced SSH & Web Terminal add-on (port 22, key-only, protection mode off),
# which is where the `ha` CLI and /config live.
Match host homeassistant exec "nc -z -G 1 192.168.10.37 22 >/dev/null 2>&1"
    HostName 192.168.10.37
Host homeassistant
    HostName 100.102.225.81
    User warrendeleon
    HostKeyAlias homeassistant-addon
    IdentityFile ~/.ssh/id_ed25519_homeassistant
    IdentitiesOnly yes
    ControlMaster auto
    ControlPath ~/.ssh/cm-%r@%h:%p
    ControlPersist 600
    ServerAliveInterval 15

Host homeassistant-tailscale
    HostName 100.102.225.81
    User warrendeleon
    HostKeyAlias homeassistant-addon
    IdentityFile ~/.ssh/id_ed25519_homeassistant
    IdentitiesOnly yes

Host homeassistant-lan
    HostName 192.168.10.37
    User warrendeleon
    HostKeyAlias homeassistant-addon
    IdentityFile ~/.ssh/id_ed25519_homeassistant
    IdentitiesOnly yes

# Defaults for all hosts
Host *
    AddKeysToAgent yes
    UseKeychain yes
    IdentityFile ~/.ssh/id_rsa
    ServerAliveInterval 60
    ServerAliveCountMax 3
    HashKnownHosts yes
    StrictHostKeyChecking ask
